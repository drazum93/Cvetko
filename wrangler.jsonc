{
  "name": "cvetko",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./"
    // Leave html_handling at its default ("auto-trailing-slash"). It does
    // 307-redirect /usluge/foo.html to /usluge/foo, which is cosmetically
    // untidy, but setting it to "none" also disables resolving "/" to
    // index.html and makes the homepage 404 - verified the hard way.
  }
}
