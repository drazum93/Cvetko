{
  "name": "cvetko",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./",
    // Serve /usluge/foo.html literally. Without this, Cloudflare's default
    // "auto-trailing-slash" strips the .html and 307-redirects every sub-page,
    // which disagrees with the .html URLs in our canonical tags and sitemap.
    "html_handling": "none"
  }
}
